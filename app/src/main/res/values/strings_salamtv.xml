    <string name="salamtv_login_password">Password</string>
    <string name="salamtv_login_action">Sign in</string>
    <string name="salamtv_login_working">Signing in…</string>
    <string name="salamtv_login_offline">Could not reach the server. Check your internet connection and try again.</string>
    <string name="salamtv_login_help">Accounts are issued by your reseller. Contact them to subscribe or renew.</string>
    <string name="salamtv_sign_out">Sign out</string>
    <string name="salamtv_sign_out_confirm">Sign out of this device? Your channels will be removed until you sign in again.</string>
    <string name="salamtv_based_on">Based on OwnTV by ahXN00, under GPLv3.</string>
    <string name="salamtv_support">Support</string>
    <string name="salamtv_support_scan">Scan the code with your phone to open our support channel.</string>
